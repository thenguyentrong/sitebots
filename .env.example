# Neon Postgres. Leave unset to run on the in-process PGlite: in development
# the on-disk cluster under .pglite/, in production the committed snapshot
# data/snapshot/pglite.tar.gz, read-only.
DATABASE_URL=

# Development: use .pglite/ (seeded from data/seed on first start).
USE_LOCAL_DB=1

# Vercel Blob: the private store sitebots-chats keeps the chats. Without it, in development, chats stay
# on disk under .cache/chats and scrape snapshots under .cache/.
BLOB_READ_WRITE_TOKEN=

# Bearer token Vercel sends to /api/cron/* routes.
CRON_SECRET=

# The crawler identifies itself. The URL must resolve to /bot on the live site
# and the mailbox must be read — sources that want to block or ask will use it.
SCRAPER_CONTACT_URL=https://sitebots.example/bot
SCRAPER_CONTACT_EMAIL=

# Public origin, used for canonical URLs and sitemap entries.
# Set SITE_URL=https://sitebots.vercel.app in production (or your custom domain).
# Production ignores localhost and falls back to the Vercel production domain.
SITE_URL=http://localhost:3000

# Vertex AI (free-text parsing, milestone 5). Unset = heuristic parser.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west3
GOOGLE_SERVICE_ACCOUNT_KEY=

# The chat at /chat. Claude API key from the "sitebots" workspace (spend limit in the Console).
ANTHROPIC_API_KEY=
# Haiku asks the first questions. Set to claude-sonnet-5-5 to run the whole chat on Sonnet.
CHAT_EARLY_MODEL=
# Salt for the daily visitor code.
CHAT_SALT=
# Scrypt hash of the /admin password, as salt:hash from hashPassword in lib/chat/admin.ts.
CHAT_ADMIN_HASH=
