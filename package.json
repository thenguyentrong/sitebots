{
  "name": "sitebots",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "scrape": "node --env-file-if-exists=.env.local --import tsx scripts/scrape/run.ts",
    "pipeline": "node --env-file-if-exists=.env.local --import tsx scripts/pipeline.ts",
    "seed:local": "node --env-file-if-exists=.env.local --import tsx scripts/seed-local.ts",
    "aliases:generate": "node --import tsx scripts/aliases-generate.ts",
    "curated": "node --env-file-if-exists=.env.local --import tsx scripts/load-curated.ts",
    "report": "node --env-file-if-exists=.env.local --import tsx scripts/report-coverage.ts",
    "shot": "node --import tsx tests/shot.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@neondatabase/serverless": "^1.1.0",
    "@next/env": "16.2.11",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@vercel/blob": "^2.6.1",
    "@xmldom/xmldom": "^0.9.12",
    "cheerio": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "meshoptimizer": "^1.2.0",
    "next": "16.2.11",
    "p-limit": "^6.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "robots-parser": "^3.0.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.0",
    "xacro-parser": "^0.3.11",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
